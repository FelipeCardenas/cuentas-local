# Only reviewed project files are eligible for version control.
/*
!/.gitignore
!/PUBLICACION.md
!/README.md
!/THIRD_PARTY_NOTICES.md
!/cuentas/
!/frontend/
/frontend/*
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/index.html
!/frontend/vite.config.js
!/frontend/README.md
!/frontend/src/
!/frontend/tests/
/frontend/src/*
!/frontend/src/*.js
!/frontend/src/*.jsx
!/frontend/src/*.css
/frontend/tests/*
!/frontend/tests/*.js
!/frontend/tests/*.cjs
!/frontend/tests/*.py
/cuentas/*
!/cuentas/*.py
!/cuentas/*.ps1
!/cuentas/*.cmd
!/cuentas/requirements.txt
!/cuentas/LEEME.md
!/cuentas/cuentas.ico
!/cuentas/cuentas-icono.png
!/cuentas/web/
/cuentas/web/*
!/cuentas/web/*.html
!/cuentas/web/*.css
!/cuentas/web/*.js

# Defense in depth, including private files accidentally placed with code.
**/__pycache__/
**/.venv/
**/node_modules/
**/.env
**/.env.*
**/*.sqlite*
**/*.db
**/*.db-*
**/*.bak
**/*.xlsx
**/*.xls
**/*.csv
**/*.log
**/*.lnk
**/*.pem
**/*.key
**/credentials*.json
**/secrets*.json
